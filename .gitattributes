* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.zip binary

# Preserve upstream license bytes used by the notice inventory.
third_party/licenses/** -text

# Preserve byte hashes and upstream whitespace in captured notice evidence.
third_party/licenses/server-extra/*.txt -text -whitespace
third_party/licenses/server-sources/*.txt -text -whitespace

# Preserve pinned upstream source bytes, including original whitespace.
third_party/st-page-flip/src/** -text -whitespace
